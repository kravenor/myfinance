# Stack produzione - rinominare in .env.production e completare i valori
# Su VPS con Apache/nginx host davanti (docker-compose.vps.yml): APP_PORT deve essere
# una porta libera diversa da 80/443, che restano al webserver host. Il vhost host
# fa da reverse proxy verso 127.0.0.1:APP_PORT.
APP_PORT=8080

# Laravel
APP_NAME=Finance
APP_ENV=production
APP_KEY=base64:CHANGE_ME
APP_DEBUG=false
APP_URL=https://finance.example.com

# Registrazione nuovi account: crea il tuo utente con true, poi rimetti false e ricrea php.
FINANCE_REGISTRATION=false

LOG_CHANNEL=stack
# Un file al giorno in storage/logs (volume laravel_logs sul VPS), tenuti 14 giorni.
LOG_STACK=daily
LOG_LEVEL=info
# Registro di sicurezza (accessi, 2FA, password) in storage/logs/security-*.log: giorni di conservazione,
# dichiarati nella Privacy policy (cambiandoli va aggiornata anche quella).
LOG_SECURITY_DAYS=90

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=finance
DB_USERNAME=finance
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# Cache / sessione / queue
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_DOMAIN=finance.example.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sanctum
SANCTUM_STATEFUL_DOMAINS=finance.example.com
FRONTEND_URL=https://finance.example.com

# Mail (opzionale): con `log` le email finiscono nel log e non arrivano a nessuno.
# Per inviarle: MAIL_MAILER=smtp e i dati del provider (es. OVH MX Plan: ssl0.ovh.net, 465).
# Utente = indirizzo completo, mittente = stessa casella. Password tra virgolette se ha
# caratteri speciali (#, $, spazi). Cifratura scelta dalla porta: MAIL_ENCRYPTION è ignorata.
# Dopo una modifica: `php artisan config:cache` e `php artisan queue:restart`.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=

# Composer/GitHub (opzionale): Personal Access Token senza scope (solo repo pubblici)
# per evitare il rate limit anonimo di GitHub (HTTP 429) su codeload.github.com in fase
# di build dell'immagine PHP. Generalo su https://github.com/settings/tokens.
GITHUB_TOKEN=

# Notifiche push (Web Push): genera le chiavi con `php artisan webpush:vapid`, una volta per ambiente.
# Senza chiavi il canale push resta spento. Il subject è un contatto (mailto:) richiesto dai servizi push.
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
